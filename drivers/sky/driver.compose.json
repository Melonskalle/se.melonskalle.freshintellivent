{
  "name": {
    "en": "Intellivent Sky / ICE",
    "sv": "Intellivent Sky / ICE"
  },
  "class": "fan",
  "capabilities": [
    "fresh_boost",
    "fresh_pause",
    "fresh_constant_speed",
    "fresh_constant_rpm",
    "fresh_humidity_level",
    "fresh_light_level",
    "fresh_voc_level",
    "fresh_airing",
    "fresh_mode",
    "fresh_rpm",
    "measure_temperature",
    "measure_humidity",
    "fresh_boost_remaining"
  ],
  "platforms": [
    "local"
  ],
  "connectivity": [
    "ble"
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "options": {
        "singular": true
      },
      "navigation": {
        "next": "auth"
      }
    },
    {
      "id": "auth",
      "navigation": {
        "prev": "list_devices"
      }
    }
  ],
  "repair": [
    {
      "id": "repair_auth"
    }
  ],
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Connection",
        "sv": "Anslutning"
      },
      "children": [
        {
          "id": "auth_key",
          "type": "text",
          "label": {
            "en": "Authentication code",
            "sv": "Autentiseringskod"
          },
          "value": "",
          "hint": {
            "en": "8 hex characters. Without it the app is read-only. Use 'Repair' to fetch it from the fan in pairing mode.",
            "sv": "8 hextecken. Utan kod är appen bara läsande. Använd 'Reparera' för att hämta den från fläkten i parkopplingsläge."
          }
        },
        {
          "id": "poll_interval",
          "type": "number",
          "label": {
            "en": "Poll interval",
            "sv": "Uppdateringsintervall"
          },
          "value": 120,
          "min": 30,
          "max": 3600,
          "units": {
            "en": "s",
            "sv": "s"
          }
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Boost & pause",
        "sv": "Boost & paus"
      },
      "children": [
        {
          "id": "boost_rpm",
          "type": "number",
          "label": {
            "en": "Boost speed",
            "sv": "Boosthastighet"
          },
          "value": 2400,
          "min": 800,
          "max": 2400,
          "step": 10,
          "units": {
            "en": "rpm",
            "sv": "varv/min"
          }
        },
        {
          "id": "boost_seconds",
          "type": "number",
          "label": {
            "en": "Boost duration",
            "sv": "Boostlängd"
          },
          "value": 600,
          "min": 60,
          "max": 3600,
          "units": {
            "en": "s",
            "sv": "s"
          }
        },
        {
          "id": "pause_minutes",
          "type": "number",
          "label": {
            "en": "Pause duration",
            "sv": "Paustid"
          },
          "value": 30,
          "min": 1,
          "max": 255,
          "units": {
            "en": "min",
            "sv": "min"
          }
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Sensor speeds",
        "sv": "Hastigheter för sensorer"
      },
      "children": [
        {
          "id": "humidity_rpm",
          "type": "number",
          "label": {
            "en": "Humidity & odour sensor",
            "sv": "Fukt- & luktsensor"
          },
          "value": 1800,
          "min": 800,
          "max": 2400,
          "step": 10,
          "units": {
            "en": "rpm",
            "sv": "varv/min"
          }
        },
        {
          "id": "timer_rpm",
          "type": "number",
          "label": {
            "en": "Light sensor & timer",
            "sv": "Ljussensor & timer"
          },
          "value": 1800,
          "min": 800,
          "max": 2400,
          "step": 10,
          "units": {
            "en": "rpm",
            "sv": "varv/min"
          }
        },
        {
          "id": "airing_rpm",
          "type": "number",
          "label": {
            "en": "Airing",
            "sv": "Vädring"
          },
          "value": 1500,
          "min": 800,
          "max": 2400,
          "step": 10,
          "units": {
            "en": "rpm",
            "sv": "varv/min"
          }
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Timer",
        "sv": "Timer"
      },
      "children": [
        {
          "id": "timer_minutes",
          "type": "number",
          "label": {
            "en": "Run time",
            "sv": "Gångtid"
          },
          "value": 15,
          "min": 1,
          "max": 60,
          "units": {
            "en": "min",
            "sv": "min"
          }
        },
        {
          "id": "timer_delay_enabled",
          "type": "checkbox",
          "label": {
            "en": "Delayed start",
            "sv": "Fördröjd start"
          },
          "value": false
        },
        {
          "id": "timer_delay_minutes",
          "type": "number",
          "label": {
            "en": "Delay",
            "sv": "Fördröjning"
          },
          "value": 0,
          "min": 0,
          "max": 10,
          "units": {
            "en": "min",
            "sv": "min"
          }
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Information",
        "sv": "Information"
      },
      "children": [
        {
          "id": "info_manufacturer",
          "type": "label",
          "label": {
            "en": "Manufacturer",
            "sv": "Tillverkare"
          },
          "value": "-"
        },
        {
          "id": "info_firmware",
          "type": "label",
          "label": {
            "en": "Firmware",
            "sv": "Firmware"
          },
          "value": "-"
        }
      ]
    }
  ]
}